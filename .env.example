# Copy this file to .env.production on the production server.
# Never commit the populated production file.
OPENAI_API_KEY=
SARVAM_API_KEY=

# Optional model overrides
TEXT_MODEL=gpt-5.4-mini-2026-03-17
NPC_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
TTS_MODEL=gpt-4o-mini-tts
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
MODERATION_MODEL=omni-moderation-latest

# Large structured story/world output provider: openai or sarvam.
# Keep openai on Sarvam Starter; switch to sarvam after upgrading the Sarvam plan.
LARGE_STRUCTURED_OUTPUT_PROVIDER=openai

# Sarvam multilingual stack
SARVAM_STORY_MODEL=sarvam-105b
# Pro plan: 16384. Increase further only if the account tier supports it.
SARVAM_STORY_MAX_TOKENS=16384
SARVAM_NPC_MODEL=sarvam-30b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
